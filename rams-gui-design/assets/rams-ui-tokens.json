{
  "meta": {
    "name": "Rams-informed fallback GUI tokens",
    "version": "1.1.0",
    "usage": "Use only when the product has no suitable design system. Adapt semantic roles to the product and verify contrast in every state. border is a hairline divider (~1.5:1); use borderStrong (>=3:1) for any control whose boundary must be perceived on its own."
  },
  "color": {
    "light": {
      "canvas": "#EDEDE7",
      "surface": "#F8F8F4",
      "surfaceStrong": "#FFFFFF",
      "text": "#1D1E1B",
      "textMuted": "#62655E",
      "border": "#C8CAC2",
      "borderStrong": "#85887F",
      "accent": "#BF3F24",
      "accentSignal": "#B83A21",
      "accentSubtle": "#F4DDD5",
      "onAccent": "#FFFFFF",
      "focus": "#355F7C",
      "success": "#2E6E4A",
      "warning": "#925C00",
      "danger": "#B3261E",
      "info": "#355F7C"
    },
    "dark": {
      "canvas": "#171814",
      "surface": "#1F201C",
      "surfaceStrong": "#282925",
      "text": "#F0F1EA",
      "textMuted": "#B4B7AE",
      "border": "#3D3F38",
      "borderStrong": "#71746C",
      "accent": "#F06A45",
      "accentSignal": "#F06A45",
      "accentSubtle": "#4B2A20",
      "onAccent": "#171814",
      "focus": "#82A9C5",
      "success": "#62A97F",
      "warning": "#D8A84C",
      "danger": "#F07B70",
      "info": "#82A9C5"
    }
  },
  "typography": {
    "fontSans": "ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif",
    "fontMono": "ui-monospace, 'SFMono-Regular', Consolas, 'Liberation Mono', monospace",
    "size": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "md": "0.9375rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.25rem"
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.45,
      "relaxed": 1.65
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "space": {
    "0": "0",
    "0_5": "0.125rem",
    "1": "0.25rem",
    "1_5": "0.375rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "xs": "0.125rem",
    "sm": "0.25rem",
    "md": "0.5rem",
    "round": "9999px"
  },
  "border": {
    "thin": "1px",
    "focus": "2px"
  },
  "control": {
    "compact": "2rem",
    "default": "2.5rem",
    "touch": "2.75rem"
  },
  "motion": {
    "instant": "0ms",
    "fast": "90ms",
    "base": "140ms",
    "slow": "220ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "shadow": {
    "none": "none",
    "overlay": "0 8px 24px rgb(0 0 0 / 0.16)"
  }
